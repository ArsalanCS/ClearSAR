# ============================================================
# ClearSAR backend configuration. Copy to `.env` and edit.
# ============================================================

# Inference backend:
#   mock  - returns a placeholder image, no GPU/model needed (great for UI dev)
#   local - loads the bridge model in-process (needs GPU + requirements-local.txt)
INFERENCE_MODE=mock

# --- Model: bridge_final (Image-to-Image Schrödinger Bridge) ---
HF_MODEL_REPO=Arsalan90/sar-to-optical-diffusion
BRIDGE_DIR=bridge_final          # holds unet.safetensors + bridge_config.json
VAE_TAG=adapted16_final          # holds base_vae.pth + detail_encoder.pth
BASE_SD_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
IMG_SIZE=256

# Default scene conditioning (overridable per-request from the UI)
COND_SEASON=summer               # spring | summer | fall | winter
COND_TERRAIN=temperate           # temperate | tropical | arctic | arid | coastal | urban

# Optional: HF token for faster downloads / private repos (repo is public, so optional)
HF_TOKEN=

# --- Scene description (runs after translation) ---
#   auto  - vlm when INFERENCE_MODE=local, otherwise facts
#   vlm   - Qwen2.5-VL reads the SAR + translated optical + measured SAR facts (GPU recommended;
#           falls back to facts if the model cannot load)
#   facts - description built from measured SAR statistics only (no GPU, no download)
#   off   - disabled
DESCRIBE_MODE=auto
VLM_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct   # 7B is better but needs ~17 GB VRAM
DESCRIBE_MAX_NEW_TOKENS=256

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./storage
